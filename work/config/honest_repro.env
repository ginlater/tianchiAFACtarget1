# Frozen honest reproduction configuration.  No qid- or answer-key settings.
AFAC_NO_DIGEST=1
AFAC_DIGEST_KEEP=insurance
AFAC_SLIM=1
AFAC_STABLE=1
AFAC_HOMO_BATCH=1
AFAC_HOMO_MAX=5
AFAC_FIN_FACTS=2
AFAC_DOM_FACTS=1
AFAC_ALIGN=1
AFAC_FIN_CALC=1
AFAC_FIN_REGISTRY=1
AFAC_NARRATIVE_REGISTRY=1
AFAC_CALC_SINGLE=1
AFAC_CALC_LEAN=1
AFAC_DET_CALC=1
AFAC_DET_CALC_EVIDENCE_CHARS=5200
AFAC_DET_CALC_THINKING_BUDGET=900
AFAC_DET_CALC_MAX_TOKENS=1800
AFAC_WHOLE_LIMIT=8000
AFAC_COMPACT_JUDGE=1
AFAC_FAST_DOCSEL=1
# Calculation routing is fail-closed and limited to the contract domain,
# whose explicit titles/company definitions reproduce the original source
# choice without erasing the Qwen doc-selection stage in other domains.
AFAC_FAST_DOCSEL_CALC=1
AFAC_FAST_DOCSEL_CALC_DOMAINS=financial_contracts
AFAC_INS_CAPSULES=1
AFAC_INS_CAPSULE_BUDGET=4800
AFAC_INS_BATCH_CAPSULE_BUDGET=7500
AFAC_INS_CALC_CAPSULE_BUDGET=6000
AFAC_INS_RAW_CAP=1800
AFAC_INS_BATCH_RAW_CAP=3000
# Ordinary literal-clause inventories are balanced as 4+3 instead of one
# five-question exclusion prompt plus a two-question legal prompt.  Two legal
# clause structures get dedicated source-complete calls:
# minor-death limits receive an independent Qwen coverage audit; the suicide
# exception stays solo so "2 years" and its incapacity exception remain in one
# continuous clause.  Routes are detected from visible wording and products.
AFAC_INS_LITERAL_BATCH_MAX=4
AFAC_INS_MINOR_CAPSULE_BUDGET=8500
AFAC_INS_SUICIDE_CAPSULE_BUDGET=6500
AFAC_INS_MINOR_AUDIT_THINKING=2200
AFAC_INS_SHARED_PROMPT=1
# Research questions are cross-document syntheses.  Six thousand source
# characters per base batch keeps an eight-question shared prompt around the
# reproducible 3.5k--4.0k prompt-token band per question without fake padding.
AFAC_RESEARCH_BATCH_RAW_CAP=6000

# Financial-report choices use compact table-aware shared batches.  The
# ordinary target counts every visible evidence character, including typed
# fact mines, so raw retrieval cannot duplicate an already extracted table.
# Questions that explicitly contrast consolidated and parent-only statements
# are isolated and receive a deep table floor because the same metric labels
# occur under two accounting scopes.
AFAC_FIN_BATCH_MAX=5
AFAC_FIN_SHARED_EVIDENCE=1
AFAC_FIN_BATCH_EVIDENCE_PER_Q=6000
AFAC_FIN_EXTENDED_EVIDENCE_PER_Q=7800
AFAC_FIN_SCOPE_EVIDENCE_PER_Q=22000
# Contract and regulatory batches likewise expose one shared union to every
# member.  Attribute their prompt equally while preserving source owners in the
# audit; visible answer blocks remain charged to their actual questions.
AFAC_FC_SHARED_PROMPT=1
AFAC_FC_SPARSE_BATCH_EXTRA=2500
AFAC_REG_SHARED_PROMPT=1
# Solo research syntheses spanning >=6 selected reports retain the protected
# option evidence but cap redundant raw context.  This keeps the authentic
# per-question prompt near the reference band without identifier-based routes.
AFAC_RESEARCH_DENSE_RAW_CAP=6000

# Explicitly freeze experimental branches off.  Empty selector variables are
# unset by generate_answer.sh because some legacy branches distinguish unset
# from an empty string.
AFAC_DEEP=0
AFAC_SLIM4=0
AFAC_DYNCAP=0
AFAC_ENT_PROBE=0
AFAC_CARDS_ONLY=0
AFAC_CALC_HETERO=0
AFAC_CALC_TABLES=0
AFAC_HETERO_B2=0
AFAC_LEAN_R2=0
AFAC_R1_ESC=0
AFAC_R1_VOTES=1
AFAC_B1_VOTES=1
AFAC_ARB_VOTES=1
AFAC_R2_COND=0
AFAC_EV_CAP_MULT=1
AFAC_TABLE_LIMIT=15000
PYTHONHASHSEED=0
